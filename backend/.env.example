# ──────────────────────────────────────────────────────────────────────────
# Sublet backend configuration
# Copy to backend/.env and fill in what you need. Every feature degrades
# gracefully: with nothing configured you still get auth + demo scanning.
# ──────────────────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# Where the React app runs (OAuth redirects + CORS)
FRONTEND_URL=http://localhost:3000

# ── Firebase Admin (needed for the daily reminder cron) ──────────────────
# Firebase Console → Project settings → Service accounts → Generate new private key
# Either paste the JSON inline:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# ...or point to the downloaded file:
# FIREBASE_SERVICE_ACCOUNT_FILE=./serviceAccountKey.json
FIREBASE_PROJECT_ID=subscription-hub-19cf9

# ── Google OAuth for Gmail scanning ───────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
#   Authorized redirect URI: http://localhost:5000/api/gmail/callback
# Also enable the "Gmail API" for the project.
# Leave blank to run scanning in demo mode (returns sample subscriptions).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/gmail/callback

# ── Bank scanning (Plaid) ──────────────────────────────────────────────────
# Free instantly at https://dashboard.plaid.com/signup — Sandbox keys need no
# approval. Team Settings → Keys → copy client_id and the "sandbox" secret.
# Leave blank to run bank scanning in demo mode (returns sample subscriptions).
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# ── AI subscription extraction (Claude) ───────────────────────────────────
# Lets the Gmail scanner use Claude to fit ANY billing email into the
# subscription tuple — merchants and phrasings the regex heuristics miss.
# Get a key at https://console.anthropic.com/ → API keys.
# Leave blank to run heuristics-only (scanning still works).
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-4-8; claude-haiku-4-5 is cheaper)
# ANTHROPIC_MODEL=claude-opus-4-8

# ── Email reminders (Gmail SMTP) ──────────────────────────────────────────
# Google Account → Security → 2-Step Verification → App passwords
SMTP_USER=
SMTP_PASS=
# MAIL_FROM="Sublet <you@gmail.com>"

# ── Misc ──────────────────────────────────────────────────────────────────
# Protects POST /api/reminders/run (external cron trigger) in production
CRON_SECRET=
# Signs the OAuth state parameter (defaults to GOOGLE_CLIENT_SECRET)
STATE_SECRET=
