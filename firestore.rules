rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Tracked subscriptions — owner only.
    match /subscriptions/{docId} {
      allow read, update, delete: if signedInAs(resource.data.uid);
      allow create: if signedInAs(request.resource.data.uid);
    }

    // Subscription candidates found by Gmail scanning — owner only.
    match /detected/{docId} {
      allow read, update, delete: if signedInAs(resource.data.uid);
      allow create: if signedInAs(request.resource.data.uid);
    }

    // Per-user settings (email, reminderDays, gmail status) — owner only.
    match /users/{uid} {
      allow read, write: if signedInAs(uid);
    }

    // OAuth/bank tokens — server (Admin SDK) only, never clients.
    match /gmailTokens/{uid} {
      allow read, write: if false;
    }
    match /plaidTokens/{uid} {
      allow read, write: if false;
    }
  }
}
