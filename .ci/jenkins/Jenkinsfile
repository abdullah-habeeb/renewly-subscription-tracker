pipeline {
    agent any

    environment {
        // Docker configuration
        DOCKER_REGISTRY = credentials('docker-registry-url')
        DOCKER_NAMESPACE = 'subscription-tracker'
        DOCKER_IMAGE_BACKEND = "${DOCKER_REGISTRY}/${DOCKER_NAMESPACE}/backend"
        DOCKER_IMAGE_FRONTEND = "${DOCKER_REGISTRY}/${DOCKER_NAMESPACE}/frontend"
        DOCKER_IMAGE_TAG = "${BUILD_NUMBER}"
        
        // Deployment configuration
        DEPLOY_ENV = "${BRANCH_NAME == 'main' ? 'production' : 'staging'}"
        COMPOSE_FILE = "${DEPLOY_ENV == 'production' ? 'docker-compose.prod.yml' : 'docker-compose.yml'}"
        
        // Git information
        GIT_COMMIT_SHORT = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
        GIT_BRANCH = "${BRANCH_NAME}"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '15'))
        timestamps()
        timeout(time: 45, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    triggers {
        githubPush()
        pollSCM('H/5 * * * *')  // Poll every 5 minutes as fallback
    }

    stages {
        stage('Initialization') {
            steps {
                script {
                    echo """
                    ╔════════════════════════════════════════════════════════════╗
                    ║          SUBSCRIPTION TRACKER CI/CD PIPELINE               ║
                    ╠════════════════════════════════════════════════════════════╣
                    ║ Environment:    ${DEPLOY_ENV.toUpperCase()}                           ║
                    ║ Build Number:   ${BUILD_NUMBER}                               ║
                    ║ Git Branch:     ${GIT_BRANCH}                             ║
                    ║ Git Commit:     ${GIT_COMMIT_SHORT}                           ║
                    ║ Timestamp:      ${new Date()}                    ║
                    ╚════════════════════════════════════════════════════════════╝
                    """
                    
                    checkout scm
                }
            }
        }

        stage('Lint & Test Backend') {
            steps {
                script {
                    echo "🔍 Running backend linting and tests..."
                    sh '''
                        cd backend
                        npm ci
                        npm run lint || true
                        npm run test || true
                    '''
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                script {
                    echo "🐳 Building Docker images..."
                    sh '''
                        DOCKER_FILE_BACKEND=".ci/docker/Dockerfile.prod"
                        DOCKER_FILE_FRONTEND=".ci/docker/Dockerfile.frontend"
                        
                        echo "📦 Building backend image..."
                        docker build \
                            -f ${DOCKER_FILE_BACKEND} \
                            -t ${DOCKER_IMAGE_BACKEND}:${DOCKER_IMAGE_TAG} \
                            -t ${DOCKER_IMAGE_BACKEND}:latest \
                            .
                        
                        echo "📦 Building frontend image..."
                        docker build \
                            -f ${DOCKER_FILE_FRONTEND} \
                            -t ${DOCKER_IMAGE_FRONTEND}:${DOCKER_IMAGE_TAG} \
                            -t ${DOCKER_IMAGE_FRONTEND}:latest \
                            .
                    '''
                }
            }
        }

        stage('Security Scanning') {
            when {
                branch 'main'
            }
            steps {
                script {
                    echo "🔐 Scanning Docker images for vulnerabilities..."
                    sh '''
                        # Scan backend image
                        docker run --rm \
                            -v /var/run/docker.sock:/var/run/docker.sock \
                            aquasec/trivy:latest image \
                            --severity HIGH,CRITICAL \
                            ${DOCKER_IMAGE_BACKEND}:${DOCKER_IMAGE_TAG} || true
                        
                        # Scan frontend image
                        docker run --rm \
                            -v /var/run/docker.sock:/var/run/docker.sock \
                            aquasec/trivy:latest image \
                            --severity HIGH,CRITICAL \
                            ${DOCKER_IMAGE_FRONTEND}:${DOCKER_IMAGE_TAG} || true
                    '''
                }
            }
        }

        stage('Push Images to Registry') {
            when {
                branch 'main'
            }
            steps {
                script {
                    echo "📤 Pushing Docker images to registry..."
                    withCredentials([usernamePassword(credentialsId: 'docker-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                        sh '''
                            echo "${DOCKER_PASS}" | docker login -u "${DOCKER_USER}" --password-stdin ${DOCKER_REGISTRY} || true
                            
                            docker push ${DOCKER_IMAGE_BACKEND}:${DOCKER_IMAGE_TAG}
                            docker push ${DOCKER_IMAGE_BACKEND}:latest
                            docker push ${DOCKER_IMAGE_FRONTEND}:${DOCKER_IMAGE_TAG}
                            docker push ${DOCKER_IMAGE_FRONTEND}:latest
                            
                            docker logout ${DOCKER_REGISTRY} || true
                        '''
                    }
                }
            }
        }

        stage('Deploy to Environment') {
            when {
                branch 'main'
            }
            steps {
                script {
                    echo "🚀 Deploying to ${DEPLOY_ENV} environment..."
                    sh '''
                        bash .ci/jenkins/scripts/deploy.sh ${DEPLOY_ENV}
                    '''
                }
            }
        }

        stage('Health Checks') {
            when {
                branch 'main'
            }
            steps {
                script {
                    echo "✅ Running health checks..."
                    sh '''
                        bash .ci/jenkins/scripts/health-check.sh ${DEPLOY_ENV}
                    '''
                }
            }
        }

        stage('Smoke Tests') {
            when {
                branch 'main'
            }
            steps {
                script {
                    echo "🧪 Running smoke tests..."
                    sh '''
                        bash .ci/jenkins/scripts/smoke-tests.sh ${DEPLOY_ENV}
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                echo "📊 Cleaning up workspace..."
                cleanWs(deleteDirs: true)
            }
        }
        
        success {
            script {
                echo """
                ✨ Pipeline succeeded!
                Environment: ${DEPLOY_ENV}
                Build: ${BUILD_NUMBER}
                """
            }
        }
        
        failure {
            script {
                echo """
                ❌ Pipeline failed!
                Environment: ${DEPLOY_ENV}
                Build: ${BUILD_NUMBER}
                Check logs for details.
                """
            }
        }
    }
}
