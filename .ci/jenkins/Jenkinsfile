pipeline {
    agent any

    environment {
        // Docker configuration
        DOCKER_NAMESPACE = 'subscription-tracker'
        DOCKER_IMAGE_BACKEND = "localhost:5000/subscription-tracker/backend"
        DOCKER_IMAGE_FRONTEND = "localhost:5000/subscription-tracker/frontend"
        DOCKER_IMAGE_TAG = "${BUILD_NUMBER}"
        
        // Deployment configuration
        COMPOSE_FILE = "docker-compose.yml"
        
        // Git information
        GIT_BRANCH = "${BRANCH_NAME ?: 'main'}"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '15'))
        timestamps()
        timeout(time: 45, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    triggers {
        githubPush()
        pollSCM('H/5 * * * *')  // Poll every 5 minutes as fallback
    }

    stages {
        stage('Initialization') {
            steps {
                script {
                    echo '====== SUBSCRIPTION TRACKER CI/CD PIPELINE ======'
                    echo "Build Number: ${BUILD_NUMBER}"
                    echo "Git Branch: ${GIT_BRANCH}"
                    
                    checkout scm
                }
            }
        }

        stage('Lint & Test Backend') {
            steps {
                script {
                    echo "🔍 Skipping npm tests (running in Docker build instead)"
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                script {
                    echo "🐳 Building Docker images..."
                    sh '''
                        DOCKER_FILE_BACKEND=".ci/docker/Dockerfile.prod"
                        DOCKER_FILE_FRONTEND=".ci/docker/Dockerfile.frontend"
                        
                        echo "📦 Building backend image..."
                        docker build \
                            -f ${DOCKER_FILE_BACKEND} \
                            -t ${DOCKER_IMAGE_BACKEND}:${DOCKER_IMAGE_TAG} \
                            -t ${DOCKER_IMAGE_BACKEND}:latest \
                            .
                        
                        echo "📦 Building frontend image..."
                        docker build \
                            -f ${DOCKER_FILE_FRONTEND} \
                            -t ${DOCKER_IMAGE_FRONTEND}:${DOCKER_IMAGE_TAG} \
                            -t ${DOCKER_IMAGE_FRONTEND}:latest \
                            .
                    '''
                }
            }
        }

        stage('Security Scanning') {
            when {
                branch 'main'
            }
            steps {
                script {
                    echo "🔐 Scanning Docker images for vulnerabilities..."
                    sh '''
                        # Scan backend image
                        docker run --rm \
                            -v /var/run/docker.sock:/var/run/docker.sock \
                            aquasec/trivy:latest image \
                            --severity HIGH,CRITICAL \
                            ${DOCKER_IMAGE_BACKEND}:${DOCKER_IMAGE_TAG} || true
                        
                        # Scan frontend image
                        docker run --rm \
                            -v /var/run/docker.sock:/var/run/docker.sock \
                            aquasec/trivy:latest image \
                            --severity HIGH,CRITICAL \
                            ${DOCKER_IMAGE_FRONTEND}:${DOCKER_IMAGE_TAG} || true
                    '''
                }
            }
        }

        stage('Push Images to Registry') {
            when {
                branch 'main'
            }
            steps {
                script {
                    echo "📤 Skipping Docker registry push (credentials not configured)"
                }
            }
        }

        stage('Deploy to Environment') {
            when {
                branch 'main'
            }
            steps {
                script {
                    echo "🚀 Skipping deployment (configure deployment environment in Jenkins)"
                }
            }
        }

        stage('Health Checks') {
            when {
                branch 'main'
            }
            steps {
                script {
                    echo "✅ Skipping health checks (deployment not configured)"
                }
            }
        }

        stage('Smoke Tests') {
            when {
                branch 'main'
            }
            steps {
                script {
                    echo "🧪 Skipping smoke tests (deployment not configured)"
                }
            }
        }
    }

    post {
        always {
            echo "📊 Build complete"
        }
        
        success {
            script {
                echo """
                ✨ Pipeline succeeded!
                Build: ${BUILD_NUMBER}
                """
            }
        }
        
        failure {
            script {
                echo """
                ❌ Pipeline failed!
                Build: ${BUILD_NUMBER}
                Check logs for details.
                """
            }
        }
    }
}
