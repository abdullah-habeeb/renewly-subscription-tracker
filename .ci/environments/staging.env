# Staging Environment Configuration
NODE_ENV=staging
PORT=5000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://user:password@staging-db.example.com:5432/subscription_tracker_staging

# API Configuration
API_TIMEOUT=30000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
JWT_SECRET=staging-secret-key-must-be-secure
CORS_ORIGIN=https://staging.example.com

# Feature Flags
ENABLE_DEBUGGING=false
ENABLE_MOCK_DATA=false

# Monitoring
SENTRY_DSN=https://staging-sentry-dsn@sentry.io/project
