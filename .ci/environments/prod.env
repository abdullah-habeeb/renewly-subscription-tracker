# Production Environment Configuration
NODE_ENV=production
PORT=5000
LOG_LEVEL=warn

# Database
DATABASE_URL=postgresql://user:password@prod-db.example.com:5432/subscription_tracker_prod

# API Configuration
API_TIMEOUT=30000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
JWT_SECRET=production-secret-key-must-be-very-secure-use-secrets-vault
CORS_ORIGIN=https://subscriptiontracker.example.com

# Feature Flags
ENABLE_DEBUGGING=false
ENABLE_MOCK_DATA=false

# Monitoring
SENTRY_DSN=https://prod-sentry-dsn@sentry.io/project
NEW_RELIC_LICENSE_KEY=production-new-relic-key
